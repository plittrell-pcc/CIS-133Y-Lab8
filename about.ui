<?xml version='1.0' encoding='utf-8'?>
<!-- ***************************************************************************
#
# Author: Paul Littrell & Adolfo Garcia
# Lab:    CIS-133Y Lab8
# Date:   November 11, 2026
# Desc:   UI design file for the About tab of the converter application.
#
# Input:  None
# Output: None
# Source: Module 8 Lab 8
# GitHub: https://github.com/plittrell-pcc/CIS-133Y-Lab8
#
# *************************************************************************** -->
<interface version="1.1">
  <object class="ttk.Frame" id="top_frame">
    <property name="height">200</property>
    <property name="padding">10</property>
    <property name="width">200</property>
    <layout manager="grid">
      <property name="column">0</property>
      <property name="propagate">True</property>
      <property name="row">0</property>
      <property name="sticky">nsew</property>
      <property type="col" id="0" name="weight">1</property>
      <property type="row" id="0" name="weight">1</property>
    </layout>
    <child>
      <object class="ttk.Label" id="top_label">
        <property name="font">{Arial} 16 {bold}</property>
        <property name="text" translatable="yes">About This App</property>
        <layout manager="grid">
          <property name="column">0</property>
          <property name="propagate">True</property>
          <property name="row">0</property>
          <property type="col" id="0" name="weight">1</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="ttk.Label" id="about_text">
        <property name="text" translatable="yes">Miles to Kilometers Converter
Created by Paul Littrell &amp; Adolfo Garcia</property>
        <property name="justify">center</property>
        <layout manager="grid">
          <property name="column">0</property>
          <property name="propagate">True</property>
          <property name="row">1</property>
          <property name="pady">20</property>
          <property type="col" id="0" name="weight">1</property>
        </layout>
      </object>
    </child>
  </object>
</interface>